{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.signconnect.dev/sign-recognition/v1/inference-request.schema.json",
  "title": "SignConnect inference prediction request v1",
  "description": "Strict realtime-to-inference request for one transient [1,30,224] window. Values must never be persisted or logged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "streamId",
    "windowSequence",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "The v1 wire-contract version."
    },
    "requestId": {
      "$ref": "#/$defs/uuid"
    },
    "streamId": {
      "$ref": "#/$defs/uuid"
    },
    "windowSequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing sequence of complete inference windows for this stream."
    },
    "frames": {
      "type": "array",
      "description": "Exactly 30 frames in strictly increasing frame-sequence and timestamp order, forming tensor shape [1,30,224].",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/frame"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "A UUID serialized with hyphens."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "A non-negative sequence number. Producers increment it monotonically; consumers reject regressions or gaps where the protocol requires continuity."
    },
    "timestampMs": {
      "type": "number",
      "minimum": 0,
      "description": "A finite, non-negative monotonic timestamp in milliseconds. Standard JSON forbids NaN and infinity; consumers also reject non-increasing timestamps."
    },
    "coordinate": {
      "type": "number",
      "minimum": -20,
      "maximum": 20,
      "description": "A finite, bounded normalized coordinate. Standard JSON numbers cannot encode NaN or positive/negative infinity."
    },
    "presence": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "description": "Point presence: 1 when tracked, otherwise 0. In the v2 feature layout, missing points retain the bounded normalized raw-image-origin sentinel; this mask is authoritative."
    },
    "frame": {
      "type": "object",
      "description": "One normalized unmirrored-source frame. Features are left hand landmarks 0-20, right hand landmarks 0-20, then the 14 v2 pose slots 0,2,5,11-21; each point is x, y, z, presence.",
      "additionalProperties": false,
      "required": [
        "sequence",
        "timestampMs",
        "features"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/$defs/sequence"
        },
        "timestampMs": {
          "$ref": "#/$defs/timestampMs"
        },
        "features": {
          "type": "array",
          "description": "Exactly 224 values: offsets 0-83 left hand, 84-167 right hand, and 168-223 pose slots 0,2,5,11-21. Each four-value group is x, y, z, presence.",
          "minItems": 224,
          "maxItems": 224,
          "prefixItems": [
            {
              "$ref": "#/$defs/coordinate"
            },
            {
              "$ref": "#/$defs/coordinate"
            },
            {
              "$ref": "#/$defs/coordinate"
            },
            {
              "$ref": "#/$defs/presence"
