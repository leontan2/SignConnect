{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.signconnect.dev/sign-recognition/v1/landmark-chunk.schema.json",
  "title": "SignConnect landmark.chunk v1",
  "description": "Strict browser-to-realtime event carrying exactly five transient normalized landmark frames. Raw image, video, pixel, blob, and base64 data are not part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "streamId",
    "sequence",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "The v1 wire-contract version."
    },
    "type": {
      "type": "string",
      "const": "landmark.chunk",
      "description": "The client event discriminator."
    },
    "streamId": {
      "$ref": "#/$defs/uuid"
    },
    "sequence": {
      "$ref": "#/$defs/sequence"
    },
    "frames": {
      "type": "array",
      "description": "Exactly five frames in strictly increasing frame-sequence and timestamp order.",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/frame"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "A UUID serialized with hyphens."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "A non-negative sequence number. Producers increment it monotonically; consumers reject regressions or gaps where the protocol requires continuity."
    },
    "timestampMs": {
      "type": "number",
      "minimum": 0,
      "description": "A finite, non-negative monotonic timestamp in milliseconds. Standard JSON forbids NaN and infinity; consumers also reject non-increasing timestamps."
    },
    "coordinate": {
      "type": "number",
      "description": "A finite normalized coordinate. Standard JSON numbers cannot encode NaN or positive/negative infinity."
    },
    "presence": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "description": "Point presence: 1 when tracked, otherwise 0. Missing points use x=y=z=0."
    },
    "frame": {
      "type": "object",
      "description": "One normalized unmirrored-source frame. Features are left hand landmarks 0-20, right hand landmarks 0-20, then pose landmarks 11-24; each point is x, y, z, presence.",
      "additionalProperties": false,
      "required": [
        "sequence",
        "timestampMs",
        "features"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/$defs/sequence"
        },
        "timestampMs": {
          "$ref": "#/$defs/timestampMs"
        },
        "features": {
          "type": "array",
          "description": "Exactly 224 values: offsets 0-83 left hand, 84-167 right hand, and 168-223 pose 11-24. Each four-value group is x, y, z, presence.",
