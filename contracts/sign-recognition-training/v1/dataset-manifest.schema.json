{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signconnect.local/contracts/sign-recognition-training/v1/dataset-manifest.schema.json",
  "title": "SignConnect privacy-safe landmark dataset manifest v1",
  "description": "Authoritative manifest for consented, pseudonymized landmark artifacts. Raw video and inline landmark tensors are intentionally outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetVersion",
    "createdAt",
    "provenance",
    "targetLanguage",
    "featureLayoutVersion",
    "preprocessingVersion",
    "datasetLicence",
    "splitPolicy",
    "samples"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "datasetVersion": { "$ref": "#/$defs/version" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "provenance": {
      "description": "Immutable dataset origin. Promotion logic must use this field, never datasetId naming conventions.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "evidence"],
          "properties": {
            "kind": { "const": "NON_PRODUCTION_SYNTHETIC" },
            "evidence": { "$ref": "#/$defs/syntheticProvenanceEvidence" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "evidence"],
          "properties": {
            "kind": { "const": "ATTESTED_SGSL_DATASET" },
            "evidence": { "$ref": "#/$defs/attestedProvenanceEvidence" }
          }
        }
      ]
    },
    "targetLanguage": {
      "const": "sg-SG",
      "description": "BCP 47 language tag used by SignConnect for Singapore Sign Language."
    },
    "featureLayoutVersion": { "const": "mediapipe-holistic-224-v1" },
    "preprocessingVersion": { "const": "shoulder-midpoint-shoulder-width-v1" },
    "datasetLicence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdxExpression", "commercialUseAllowed", "redistributionAllowed"],
      "properties": {
        "spdxExpression": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+() -]*$"
        },
        "commercialUseAllowed": { "type": "boolean" },
        "redistributionAllowed": { "type": "boolean" }
      }
    },
    "splitPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "locked", "assignmentSha256", "testSignerCount"],
      "properties": {
        "strategy": { "const": "SIGNER_INDEPENDENT" },
        "locked": { "const": true },
        "assignmentSha256": { "$ref": "#/$defs/sha256" },
        "testSignerCount": { "type": "integer", "minimum": 1 }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "syntheticProvenanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "generatorId", "generatorVersion", "seed"],
      "properties": {
        "type": { "const": "SYNTHETIC_GENERATOR" },
        "generatorId": { "const": "signconnect-ml-generate-synthetic" },
        "generatorVersion": { "$ref": "#/$defs/version" },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "attestedProvenanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "recordId", "sha256", "verifiedAt", "verifiedByRole"],
      "properties": {
        "type": { "const": "DATASET_PROVENANCE_ATTESTATION" },
        "recordId": {
          "type": "string",
          "pattern": "^provenance_[a-f0-9]{16,64}$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "verifiedAt": { "$ref": "#/$defs/timestamp" },
        "verifiedByRole": { "enum": ["DATA_STEWARD", "PRIVACY_REVIEWER"] }
      }
    },
    "landmarkPath": {
      "type": "string",
      "pattern": "^landmarks/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.npz$",
      "description": "Repository-independent path to the v1 NPZ archive. Absolute paths, traversal, other formats, and raw-video extensions are rejected."
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleId",
        "signerId",
        "labelId",
        "language",
        "handedness",
        "captureCondition",
        "captureTimestamp",
        "landmarkArtifact",
        "frameCount",
        "featureCount",
        "featureLayoutVersion",
        "consentAttestation",
        "usageRightsAttestation",
        "splitAssignment"
      ],
      "properties": {
        "sampleId": {
          "type": "string",
          "pattern": "^sample_[a-f0-9]{16,64}$"
        },
        "signerId": {
          "type": "string",
          "pattern": "^sgn_[a-f0-9]{12,64}$",
          "description": "Stable pseudonymous identifier. Names, email addresses, and external participant identifiers are forbidden."
        },
        "labelId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "language": { "const": "sg-SG" },
        "handedness": {
          "enum": ["LEFT", "RIGHT", "TWO_HANDED", "NOT_APPLICABLE", "UNKNOWN"]
        },
        "captureCondition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lighting", "background", "cameraPosition", "occlusion"],
          "properties": {
            "lighting": { "enum": ["LOW", "INDOOR", "DAYLIGHT", "MIXED"] },
            "background": { "enum": ["PLAIN", "CLUTTERED", "MIXED"] },
            "cameraPosition": { "enum": ["DESKTOP", "LAPTOP", "MOBILE", "OTHER"] },
            "occlusion": { "enum": ["NONE", "PARTIAL"] }
          }
        },
        "captureTimestamp": { "$ref": "#/$defs/timestamp" },
        "landmarkArtifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "mediaType"],
          "properties": {
            "path": { "$ref": "#/$defs/landmarkPath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "mediaType": { "const": "application/x-npz" }
          }
        },
        "frameCount": { "const": 30 },
        "featureCount": { "const": 224 },
        "featureLayoutVersion": { "const": "mediapipe-holistic-224-v1" },
        "consentAttestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "attestationId", "consentedAt", "permittedUses", "withdrawalStatus"],
          "properties": {
            "status": { "const": "VERIFIED" },
            "attestationId": {
              "type": "string",
              "pattern": "^consent_[a-f0-9]{16,64}$"
            },
            "consentedAt": { "$ref": "#/$defs/timestamp" },
            "permittedUses": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": ["MODEL_TRAINING", "MODEL_EVALUATION", "MODEL_DISTRIBUTION", "COMMERCIAL_DEPLOYMENT"]
              },
              "allOf": [
                { "contains": { "const": "MODEL_TRAINING" } },
                { "contains": { "const": "MODEL_EVALUATION" } }
              ]
            },
            "withdrawalStatus": { "const": "ACTIVE" }
          }
        },
        "usageRightsAttestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "basis", "sourceRecordId", "attestedAt", "attestedByRole", "restrictions"],
          "properties": {
            "status": { "const": "VERIFIED" },
            "basis": { "enum": ["PARTICIPANT_CONSENT", "DATASET_LICENCE"] },
            "sourceRecordId": {
              "type": "string",
              "pattern": "^rights_[a-f0-9]{16,64}$"
            },
            "attestedAt": { "$ref": "#/$defs/timestamp" },
            "attestedByRole": { "enum": ["DATA_STEWARD", "PRIVACY_REVIEWER"] },
            "restrictions": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "splitAssignment": { "enum": ["TRAIN", "VALIDATION", "TEST"] }
      }
    }
  }
}
