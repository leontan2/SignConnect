{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.signconnect.dev/realtime-room/v1/room-join.schema.json",
  "title": "SignConnect room join event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "room.join" },
    "ticket": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S",
      "description": "Initial short-lived realtime ticket. It is mutually exclusive with resumeToken."
    },
    "resumeToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S",
      "description": "Short-lived reconnect credential. It is mutually exclusive with ticket and remains connection-private."
    }
  },
  "oneOf": [
    {
      "required": ["ticket"],
      "properties": {
        "ticket": true,
        "resumeToken": false
      }
    },
    {
      "required": ["resumeToken"],
      "properties": {
        "ticket": false,
        "resumeToken": true
      }
    }
  ]
}
