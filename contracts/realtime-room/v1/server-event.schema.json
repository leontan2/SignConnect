{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.signconnect.dev/realtime-room/v1/server-event.schema.json",
  "title": "SignConnect room server event v1",
  "description": "Ordered public broadcasts consume a room-wide sequence. Join handshakes, snapshots, denials, target-private call signals, and errors carry a baseline or private sequence and do not consume public room order.",
  "oneOf": [
    { "$ref": "#/$defs/roomJoined" },
    { "$ref": "#/$defs/roomSnapshot" },
    { "$ref": "#/$defs/participantPresence" },
    { "$ref": "#/$defs/participantUpdated" },
    { "$ref": "#/$defs/signerGranted" },
    { "$ref": "#/$defs/signerDenied" },
    { "$ref": "#/$defs/signerReleased" },
    { "$ref": "#/$defs/captionFinal" },
    { "$ref": "#/$defs/chatMessage" },
    { "$ref": "#/$defs/callSignal" },
    { "$ref": "#/$defs/roomError" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "schemaVersion": { "type": "integer", "const": 1 },
    "publicSequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Strictly increasing sequence shared by ordered public room broadcasts. Every participant receives the same public event with the same sequence."
    },
    "baselineSequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Latest public room sequence at creation time. This private handshake, snapshot, or denial does not itself consume public room order; zero means no earlier public event or a pre-join denial."
    },
    "privateSequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Connection-private diagnostic sequence. It must not advance the client's public-room sequence cursor."
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "participantPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "role"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "role": { "type": "string", "enum": ["HOST", "GUEST"] },
        "activeSigner": { "type": "boolean" }
      }
    },
    "roomJoined": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "participantId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "const": "room.joined" },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "participantId": { "$ref": "#/$defs/uuid" },
        "resumeToken": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "resumeExpiresAt": { "$ref": "#/$defs/occurredAt" },
        "sequence": { "$ref": "#/$defs/baselineSequence" },
        "payload": { "$ref": "#/$defs/participantPayload" },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      },
      "dependentRequired": {
        "resumeToken": ["resumeExpiresAt"],
        "resumeExpiresAt": ["resumeToken"]
      }
    },
    "snapshotParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantId", "displayName", "role"],
      "properties": {
        "participantId": { "$ref": "#/$defs/uuid" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "role": { "type": "string", "enum": ["HOST", "GUEST"] },
        "activeSigner": { "type": "boolean" }
      }
    },
    "roomSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "const": "room.snapshot" },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/baselineSequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["participants"],
          "properties": {
            "participants": {
              "type": "array",
              "maxItems": 50,
              "items": { "$ref": "#/$defs/snapshotParticipant" }
            }
          }
        },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      }
    },
    "participantPresence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "participantId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "enum": ["participant.joined", "participant.left"] },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "participantId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/publicSequence" },
        "payload": { "$ref": "#/$defs/participantPayload" },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      }
    },
    "participantUpdated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "participantId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "const": "participant.updated" },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "participantId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/publicSequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["displayName", "role", "activeSigner"],
          "properties": {
            "displayName": { "type": "string", "minLength": 1, "maxLength": 50 },
            "role": { "type": "string", "enum": ["HOST", "GUEST"] },
            "activeSigner": { "type": "boolean" }
          }
        },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      }
    },
    "signerGranted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "participantId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "const": "signer.granted" },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "participantId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/publicSequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestId", "streamId"],
          "properties": {
            "requestId": { "$ref": "#/$defs/uuid" },
            "streamId": { "$ref": "#/$defs/uuid" }
          }
        },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      }
    },
    "signerDenied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "streamId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "const": "signer.denied" },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "streamId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/baselineSequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestId", "reason"],
          "properties": {
            "requestId": { "$ref": "#/$defs/uuid" },
            "reason": { "type": "string", "enum": ["SIGNER_UNAVAILABLE", "ALREADY_ACTIVE", "NOT_JOINED"] }
          }
        },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      }
    },
    "signerReleased": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "participantId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "const": "signer.released" },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "participantId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/publicSequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestId", "streamId", "reason"],
          "properties": {
            "requestId": { "$ref": "#/$defs/uuid" },
            "streamId": { "$ref": "#/$defs/uuid" },
            "reason": { "type": "string", "enum": ["recognition_stopped", "user_request", "disconnected"] }
          }
        },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      }
    },
    "captionFinal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "participantId", "captionId", "streamId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "const": "caption.final" },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "participantId": { "$ref": "#/$defs/uuid" },
        "captionId": { "$ref": "#/$defs/uuid" },
        "streamId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/publicSequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labelId", "text", "confidence", "modelVersion", "inferenceLatencyMs", "mockModel", "sourceDisplayName"],
          "properties": {
            "labelId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]*$" },
            "text": { "type": "string", "minLength": 1, "maxLength": 240 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "modelVersion": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
            "inferenceLatencyMs": { "type": "number", "minimum": 0 },
            "mockModel": { "type": "boolean" },
            "sourceDisplayName": { "type": "string", "minLength": 1, "maxLength": 50 }
          }
        },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      }
    },
    "chatText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S",
      "allOf": [
        { "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$" }
      ]
    },
    "chatMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "participantId", "messageId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "const": "chat.message" },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "participantId": { "$ref": "#/$defs/uuid" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/publicSequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "sourceDisplayName"],
          "properties": {
            "text": { "$ref": "#/$defs/chatText" },
            "sourceDisplayName": { "type": "string", "minLength": 1, "maxLength": 50 }
          }
        },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      }
    },
    "sessionDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdp"],
      "properties": {
        "sdp": { "type": "string", "minLength": 1, "maxLength": 65535 }
      }
    },
    "iceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate"],
      "properties": {
        "candidate": { "type": "string", "maxLength": 8192 },
        "sdpMid": { "type": ["string", "null"], "maxLength": 256 },
        "sdpMLineIndex": { "type": ["integer", "null"], "minimum": 0 },
        "usernameFragment": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "callReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "mediaState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audioEnabled", "videoEnabled"],
      "properties": {
        "audioEnabled": { "type": "boolean" },
        "videoEnabled": { "type": "boolean" }
      }
    },
    "callSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "participantId", "targetParticipantId", "signalId", "callId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": {
          "type": "string",
          "enum": ["call.offer", "call.answer", "call.ice-candidate", "call.decline", "call.leave", "media.state"]
        },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "participantId": { "$ref": "#/$defs/uuid" },
        "targetParticipantId": { "$ref": "#/$defs/uuid" },
        "signalId": { "$ref": "#/$defs/uuid" },
        "callId": { "$ref": "#/$defs/uuid" },
        "sequence": {
          "$ref": "#/$defs/baselineSequence",
          "description": "Latest public room sequence at routing time. A target-private call signal does not consume public room order."
        },
        "payload": { "type": "object" },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["call.offer", "call.answer"] } }
          },
          "then": { "properties": { "payload": { "$ref": "#/$defs/sessionDescription" } } }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "call.ice-candidate" } }
          },
          "then": { "properties": { "payload": { "$ref": "#/$defs/iceCandidate" } } }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["call.decline", "call.leave"] } }
          },
          "then": { "properties": { "payload": { "$ref": "#/$defs/callReason" } } }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "media.state" } }
          },
          "then": { "properties": { "payload": { "$ref": "#/$defs/mediaState" } } }
        }
      ]
    },
    "roomError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "meetingId", "sequence", "payload", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "type": { "type": "string", "const": "room.error" },
        "meetingId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/privateSequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "JOIN_REQUIRED",
                "INVALID_JOIN",
                "ALREADY_JOINED",
                "ROOM_FULL",
                "ROOM_NOT_FOUND",
                "REALTIME_TICKET_EXPIRED",
                "TICKET_EXPIRED",
                "PARTICIPANT_CONNECTED",
                "INVALID_SIGNER_EVENT",
                "INVALID_CHAT_MESSAGE",
                "INVALID_CALL_SIGNAL",
                "CALL_TARGET_UNAVAILABLE"
              ]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        },
        "occurredAt": { "$ref": "#/$defs/occurredAt" }
      }
    }
  }
}
