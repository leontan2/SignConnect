{
  "name": "signconnect",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend/apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "dev": "concurrently --names meeting,shell --prefix-colors yellow,green \"npm run dev --workspace @signconnect/meeting\" \"npm run dev --workspace @signconnect/shell\"",
    "dev:shell": "npm run dev --workspace @signconnect/shell",
    "dev:meeting": "npm run dev --workspace @signconnect/meeting",
    "build": "npm run build --workspace @signconnect/meeting && npm run build --workspace @signconnect/shell",
    "test": "npm run test --workspaces --if-present",
    "test:contracts:training": "node contracts/sign-recognition-training/v1/validate-fixtures.mjs",
    "test:ml": "uv run --project ml/sign-recognition --extra test --frozen pytest -W error",
    "test:e2e": "node scripts/run-recognition-e2e.mjs --project=chromium",
    "test:e2e:installed": "node scripts/run-recognition-e2e.mjs --project=chrome && node scripts/run-recognition-e2e.mjs --project=edge",
    "test:e2e:performance": "node scripts/run-recognition-e2e.mjs --performance",
    "test:e2e:simulator": "node scripts/run-recognition-e2e.mjs --simulator",
    "test:e2e:list": "playwright test --list",
    "test:e2e:runner:self-test": "node scripts/run-recognition-e2e.mjs --self-test",
    "typecheck": "tsc --noEmit -p frontend/apps/meeting/tsconfig.json && tsc --noEmit -p frontend/apps/shell/tsconfig.json",
    "check": "npm run typecheck && npm test && npm run test:contracts:training && npm run test:ml",
    "check:staged": "node scripts/check-staged-files.mjs",
    "check:push": "npm run check && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "concurrently": "9.1.2",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.3",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.2",
    "typescript": "5.7.2",
    "webpack": "5.110.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.6"
  }
}
