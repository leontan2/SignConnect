{
  "name": "signconnect",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend/apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names meeting,shell --prefix-colors yellow,green \"npm run dev --workspace @signconnect/meeting\" \"npm run dev --workspace @signconnect/shell\"",
    "dev:shell": "npm run dev --workspace @signconnect/shell",
    "dev:meeting": "npm run dev --workspace @signconnect/meeting",
    "build": "npm run build --workspace @signconnect/meeting && npm run build --workspace @signconnect/shell",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "concurrently": "9.1.2",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.3",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.2",
    "typescript": "5.7.2",
    "webpack": "5.110.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.6"
  }
}